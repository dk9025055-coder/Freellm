# GEMINI_API_KEY: Optional server-side Gemini API key (automatically available in AI Studio).
GEMINI_API_KEY=""

# APP_URL: Public URL where this router is hosted.
APP_URL="http://localhost:3000"

# PORT: 3000 for local development / AI Studio; 7860 for Hugging Face Docker Spaces.
PORT="3000"

# ROUTER_MASTER_KEY: Optional secret protecting /api/router/sync, /api/router/clear, and /v1/* endpoints.
# When set, pass it via Authorization: Bearer <key> or X-Router-Master-Key header.
ROUTER_MASTER_KEY=""

# ROUTER_VAULT_JSON: Optional exported encrypted (or plaintext JSON) vault envelope loaded into RAM on server boot.
# Enables zero-disk headless deployment on Hugging Face Spaces, Fly.io, Render, or Cloud Run.
ROUTER_VAULT_JSON=""

# ROUTER_VAULT_PASSPHRASE: Optional passphrase to decrypt ROUTER_VAULT_JSON (falls back to ROUTER_MASTER_KEY if omitted).
ROUTER_VAULT_PASSPHRASE=""
